# Google Sheets CSV-Export-URL für den Gewichts-Sync.
# Beispiel: https://docs.google.com/spreadsheets/d/<SHEET_ID>/export?format=csv
SHEETS_CSV_URL=

# Optional: Startjahr für die erste KW im Sheet.
# Wird das Jahr nicht gesetzt, fällt der Adapter auf (aktuelles Jahr - 2) zurück.
SHEETS_START_YEAR=
