# Google Sheets CSV-Export-URL für den Gewichts-Sync.
# Beispiel: https://docs.google.com/spreadsheets/d/<SHEET_ID>/export?format=csv
SHEETS_CSV_URL=

# Optional: Startjahr für die erste KW im Sheet.
# Wird das Jahr nicht gesetzt, fällt der Adapter auf (aktuelles Jahr - 2) zurück.
SHEETS_START_YEAR=

# Garmin Connect Login. Tokens werden nach erstem Login in data/garmin/ gecached,
# danach wird das Passwort nur bei Token-Ablauf erneut benötigt.
GARMIN_USERNAME=
GARMIN_PASSWORD=

# Turso libSQL (Production). Lokal leer lassen → fällt auf data/health.db zurück.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Bearer-Token für /api/cron/sync (Vercel setzt das automatisch via CRON_SECRET-Header).
CRON_SECRET=

# Cookie für FDDB-Scraping (Nutrition-Sync). Läuft regelmäßig ab → neu kopieren.
FDDB_COOKIE=

# Anthropic API-Key (Claude) — KI-Plan-Generierung, Chat, Tagesnotiz.
ANTHROPIC_API_KEY=

# OpenRouter API-Key (optional) — ermöglicht die Wahl eines kostenlosen
# DeepSeek-Modells für Plan-Generierung + Chat. Kostenlos: openrouter.ai/keys
OPENROUTER_API_KEY=
