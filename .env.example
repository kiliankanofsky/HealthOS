# HealthOS environment variables.
#
# `npm run setup` creates a .env.local from this file and fills in a generated
# BETTER_AUTH_SECRET. Everything below is OPTIONAL: without any of it the app
# runs against a local SQLite file, and the demo mode has sample data to show.
# Add credentials only for the integrations you actually want to sync.

# --- Auth (required in production) -------------------------------------------
# Signing secret for sessions and cookies. Generate one with:
#   openssl rand -base64 32
BETTER_AUTH_SECRET=
# Base URL of the app. Vercel preview deployments override this automatically.
BETTER_AUTH_URL=http://localhost:3000

# --- Database ----------------------------------------------------------------
# Left empty, the app uses the local file data/health.db.
# Set these to run against Turso (libSQL Cloud) — required on Vercel.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Public demo mode: a second, completely separate database holding generated
# sample data. Locally it always falls back to data/demo.db, so the demo works
# out of the box. In a hosted deployment the demo mode is OFF unless this URL
# is set — the entry button is not even rendered.
#   turso db create healthos-demo
#   turso db show healthos-demo --url      # → TURSO_DEMO_DATABASE_URL
#   turso db tokens create healthos-demo   # → TURSO_DEMO_AUTH_TOKEN
# Then seed it with: USE_TURSO=1 npm run db:seed:demo
TURSO_DEMO_DATABASE_URL=
TURSO_DEMO_AUTH_TOKEN=

# --- AI features (optional) --------------------------------------------------
# Powers the daily overview, the dashboard chat and the training-plan generator.
# Without a key those features surface an error; everything else works.
ANTHROPIC_API_KEY=
# Optional alternative: a free DeepSeek model via OpenRouter (openrouter.ai/keys).
OPENROUTER_API_KEY=

# --- Data sources (optional) -------------------------------------------------
# Garmin Connect account. Tokens are cached in the database after the first
# login. Accounts with MFA enabled are not supported by the client library.
GARMIN_USERNAME=
GARMIN_PASSWORD=

# Session cookie for fddb.info (nutrition sync, HTML scraping).
# Expires regularly — copy a fresh one from your browser when the sync fails.
FDDB_COOKIE=

# --- Scheduled sync ----------------------------------------------------------
# Bearer token that GET /api/cron/sync requires. On Vercel this is sent
# automatically for cron invocations.
CRON_SECRET=
